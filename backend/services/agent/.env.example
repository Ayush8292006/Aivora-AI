PORT=8003
CHAT_SERVICE=http://localhost:8002
REDIS_URL=redis://localhost:6379
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agent

# LLM Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=your_openrouter_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Agent Model Configuration
CODING_MODEL=deepseek/deepseek-chat
PDF_MODEL=deepseek/deepseek-chat
PPT_MODEL=deepseek/deepseek-chat
IMAGE_PROVIDER=gemini # "gemini" | "openrouter"
IMAGE_MODEL=imagen-3.0-generate-002
VISION_MODEL=gemini-2.5-flash
IMAGE_DAILY_LIMIT=50

# Storage Settings
STORAGE_DIR=./storage
FILE_RETENTION_DAYS=7
MAX_UPLOAD_MB=20

# Razorpay Test Mode Payment Credentials
# Get your test keys from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
